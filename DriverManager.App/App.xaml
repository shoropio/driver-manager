<Application x:Class="DriverManager.App.App"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:DriverManager.App"
              xmlns:converters="clr-namespace:DriverManager.App.Converters"
              xmlns:views="clr-namespace:DriverManager.App.Views"
              StartupUri="MainWindow.xaml">
    <Application.Resources>
        <converters:EnumToVisibilityConverter x:Key="EnumToVisibility" />
        <converters:StringEqualityToVisibilityConverter x:Key="StringEqualityToVisibility" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        <converters:StringToBrushConverter x:Key="StringToBrushConverter" />
        <converters:ViewTemplateSelector x:Key="ViewTemplateSelector">
            <converters:ViewTemplateSelector.DashboardTemplate>
                <DataTemplate>
                    <views:DashboardView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.DashboardTemplate>
            <converters:ViewTemplateSelector.DriversTemplate>
                <DataTemplate>
                    <views:DriversView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.DriversTemplate>
            <converters:ViewTemplateSelector.GpuTemplate>
                <DataTemplate>
                    <views:GpuView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.GpuTemplate>
            <converters:ViewTemplateSelector.SystemTemplate>
                <DataTemplate>
                    <views:SystemInfoView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.SystemTemplate>
            <converters:ViewTemplateSelector.UpdatesTemplate>
                <DataTemplate>
                    <views:UpdatesView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.UpdatesTemplate>
            <converters:ViewTemplateSelector.DownloadsTemplate>
                <DataTemplate>
                    <views:DownloadsView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.DownloadsTemplate>
            <converters:ViewTemplateSelector.BackupsTemplate>
                <DataTemplate>
                    <views:BackupsView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.BackupsTemplate>
            <converters:ViewTemplateSelector.RestoreTemplate>
                <DataTemplate>
                    <views:RestoreView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.RestoreTemplate>
            <converters:ViewTemplateSelector.HistoryTemplate>
                <DataTemplate>
                    <views:HistoryView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.HistoryTemplate>
            <converters:ViewTemplateSelector.SettingsTemplate>
                <DataTemplate>
                    <views:SettingsView DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}" />
                </DataTemplate>
            </converters:ViewTemplateSelector.SettingsTemplate>
        </converters:ViewTemplateSelector>

        <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2563EB" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF1D4ED8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF24406B" />
        <SolidColorBrush x:Key="IconBrush" Color="#FFA9ABBE" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#FFB0B4C8" />

        <Geometry x:Key="IconHome">M3 9.5 L12 2.5 L21 9.5 L21 20 a1 1 0 0 1 -1 1 L15 21 v-6 h-6 v6 H4 a1 1 0 0 1 -1 -1 Z</Geometry>
        <Geometry x:Key="IconDrivers">M21 16 V8 a2 2 0 0 0 -1 -1.73 l-7 -4 a2 2 0 0 0 -2 0 l-7 4 A2 2 0 0 0 3 8 v8 a2 2 0 0 0 1 1.73 l7 4 a2 2 0 0 0 2 0 l7 -4 A2 2 0 0 0 21 16 Z M3.27 6.96 L12 12.01 L20.73 6.96 M12 22.08 V12</Geometry>
        <Geometry x:Key="IconGpu">M2 5 a2 2 0 0 1 2 -2 h16 a2 2 0 0 1 2 2 v10 a2 2 0 0 1 -2 2 H4 a2 2 0 0 1 -2 -2 Z M8 21 h8 M12 17 v4</Geometry>
        <Geometry x:Key="IconUpdates">M23 4 v6 h-6 M1 20 v-6 h6 M3.51 9 a9 9 0 0 1 14.85 -3.36 L23 10 M1 14 l4.64 4.36 A9 9 0 0 0 20.49 15</Geometry>
        <Geometry x:Key="IconDownloads">M21 15 v4 a2 2 0 0 1 -2 2 H5 a2 2 0 0 1 -2 -2 v-4 M7 10 l5 5 l5 -5 M12 15 V3</Geometry>
        <Geometry x:Key="IconBackups">M12 8 c4.97 0 9 -1.79 9 -4 s-4.03 -4 -9 -4 s-9 1.79 -9 4 s4.03 4 9 4 Z M3 8 v8 c0 2.21 4.03 4 9 4 s9 -1.79 9 -4 V8 M3 12 c0 2.21 4.03 4 9 4 s9 -1.79 9 -4</Geometry>
        <Geometry x:Key="IconRestore">M1 4 v6 h6 M3.51 15 a9 9 0 1 0 2.13 -9.36 L1 10</Geometry>
        <Geometry x:Key="IconHistory">M12 2 a10 10 0 1 0 0 20 a10 10 0 0 0 0 -20 Z M12 6 v6 l4 2</Geometry>
        <Geometry x:Key="IconSettings">M4 21 v-7 M4 10 V3 M12 21 v-9 M12 8 V3 M20 21 v-5 M20 12 V3 M1 14 h6 M9 8 h6 M17 16 h6</Geometry>
        <Geometry x:Key="IconShield">M12 2 l8 3 v6 c0 5 -3.5 9.5 -8 11 c-4.5 -1.5 -8 -6 -8 -11 V5 Z</Geometry>
        <Geometry x:Key="IconSystem">M2 6 a2 2 0 0 1 2 -2 h16 a2 2 0 0 1 2 2 v9 a2 2 0 0 1 -2 2 H4 a2 2 0 0 1 -2 -2 Z M2 19 h20 M9 16 v3 M15 16 v3</Geometry>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF32334B" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF3D3F60" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF2F3150" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF3D3F60" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF4A4D73" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#FF32334B" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF2A2A3C" />
                    <Setter Property="Foreground" Value="#FF6A6F84" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF2A2A3C" />
                    <Setter Property="Foreground" Value="#FF6A6F84" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BrightProgressBar" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#FF2A2A44" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="0" />
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left" RadiusX="3" RadiusY="3" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF222233" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="#FF8B8FA6" />
        </Style>

        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB0B4C8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style x:Key="TableRowTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="TableVersionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableRowTextStyle}">
            <Setter Property="Foreground" Value="#FFC9D3E6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="TableActionCellStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style x:Key="TableRowBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#FF2D2D43" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFB0B4C8" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2D2D43" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF3D3F60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2D2D43" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#FF3D3F60" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Border x:Name="Chrome"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="0"
                                                    SnapsToDevicePixels="True" />
                                            <Path x:Name="Arrow"
                                                  Width="11" Height="7"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,12,0"
                                                  Data="M0,0 L11,0 L5.5,7 Z"
                                                  Fill="#FFC3C7D9"
                                                  IsHitTestVisible="False" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="#FFE8EAF2" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Border Background="#FF222233"
                                        BorderBrush="#FF3D3F60"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4A4D73" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4A4D73" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF3D3F60" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FF3D3F60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
