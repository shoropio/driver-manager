<UserControl x:Class="DriverManager.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MaintenanceViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Mantenimiento" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Escanea y repara problemas de controladores del sistema." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource ActionButtonStyle}" Content="Escanear sistema"
                    Command="{Binding ScanCommand}" HorizontalAlignment="Left" Padding="20,0" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}" />
            <Button Grid.Column="4" Style="{StaticResource PrimaryActionButtonStyle}" Content="Reparar todo"
                    Command="{Binding RepairAllCommand}" Padding="20,0" />
        </Grid>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" FontSize="13" Foreground="#FFA9ABBE"
                   Text="{Binding StatusMessage}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}" />

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FFFF6B6B" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Con error" Foreground="#FFB0B4C8" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding BrokenCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FFFFB454" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Faltantes" Foreground="#FFB0B4C8" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding MissingCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF9ED27A" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Obsoletos" Foreground="#FFB0B4C8" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding ObsoleteCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource CardBorderStyle}" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#FF8B8FA6" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Sin firmar" Foreground="#FFB0B4C8" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding UnsignedCount}" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="180" />
                    <ColumnDefinition Width="1.2*" MinWidth="100" />
                    <ColumnDefinition Width="1.2*" MinWidth="100" />
                    <ColumnDefinition Width="3*" MinWidth="200" />
                    <ColumnDefinition Width="1.5*" MinWidth="120" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="5" Style="{StaticResource TableRowBorderStyle}" Background="#FF26263C">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Dispositivo" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="Tipo" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="Severidad" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="Descripción" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="Acción" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Grid.ColumnSpan="5"
                         ItemsSource="{Binding FilteredIssues}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF26263C" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF32334B" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" MinWidth="180" />
                                    <ColumnDefinition Width="1.2*" MinWidth="100" />
                                    <ColumnDefinition Width="1.2*" MinWidth="100" />
                                    <ColumnDefinition Width="3*" MinWidth="200" />
                                    <ColumnDefinition Width="1.5*" MinWidth="120" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{Binding IssueTypeIcon}" Width="14" Height="14" Stretch="Uniform"
                                              StrokeThickness="1.2" Stroke="{Binding SeverityColor}" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource TableRowTextStyle}" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" Text="{Binding DeviceName}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}"
                                               Text="{Binding IssueTypeText}" Foreground="{Binding SeverityColor}" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}"
                                               Text="{Binding SeverityText}" />
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}" Foreground="#FFA9ABBE"
                                               Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}" />
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource TableRowBorderStyle}" Padding="8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Reparar"
                                                Command="{Binding DataContext.RepairSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryActionButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FFA9ABBE" FontSize="14">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Presiona 'Escanear sistema' para buscar problemas de controladores." />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasScanned}" Value="True">
                                    <Setter Property="Text" Value="No se encontraron problemas." />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasScanned}" Value="True" />
                                        <Condition Binding="{Binding FilteredIssues.Count}" Value="0" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
