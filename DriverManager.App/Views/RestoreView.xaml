<UserControl x:Class="DriverManager.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="LabelTextStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFA9ABBE" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Restauración" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Restaura controladores desde un respaldo o crea un punto de restauración del sistema." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Text="Restaurar respaldo" />
                <TextBlock Margin="0,4,0,0" Style="{StaticResource LabelTextStyle}"
                           Text="Selecciona un respaldo en la lista y restaura sus controladores." />

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Margin="0,4,0,0" FontSize="14" FontWeight="SemiBold"
                               Text="{Binding SelectedBackup.BackupName, TargetNullValue='No hay respaldo seleccionado'}" />
                    <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#FFA9ABBE"
                               Text="{Binding SelectedBackup.BackupPath, TargetNullValue='No disponible'}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="#FF7AC5FF"
                               Text="{Binding SelectedBackup.Drivers.Count, StringFormat='{} {0} controladores incluidos', FallbackValue='0 controladores incluidos'}" />
                </StackPanel>

                <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButtonStyle}" Content="Restaurar controladores"
                            Command="{Binding RestoreBackupCommand}" />
                    <Button Margin="12,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="Crear punto de restauración"
                            Command="{Binding CreateRestorePointCommand}" />
                </StackPanel>

                <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="#FF9ED27A"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Text="Cómo funciona" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap">
                    La restauración reinstala los controladores incluidos en el respaldo mediante pnputil.
                    Se requiere permiso de administrador y puede ser necesario reiniciar el equipo después
                    de la restauración.
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
