<UserControl x:Class="DriverManager.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Historial de actividad" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Registro de las operaciones realizadas con Driver Manager." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock FontSize="12" Foreground="#FFA9ABBE" Text="Archivo de log" />
                <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#FF7AC5FF"
                           Text="{Binding LogFilePath}" TextWrapping="Wrap" />
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Content="Actualizar"
                    Command="{Binding RefreshHistoryCommand}" />
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <TextBox Text="{Binding HistoryLog, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="#FF1B1B2A" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12"
                     Foreground="#FFC9D3E6"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Padding="12" />
        </Border>
    </Grid>
</UserControl>
