<UserControl x:Class="DriverManager.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Text="Info del sistema" />
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                           Text="Resumen del equipo: hardware, BIOS, placa base y sistema operativo." />
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ActionButtonStyle}" Content="Actualizar"
                            Command="{Binding RefreshSystemInfoCommand}" />
                    <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#FF9ED27A"
                               Text="{Binding SystemInfoStatus}" TextWrapping="Wrap" />
                </StackPanel>

                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding SystemInfoSections}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,16,16" Padding="16" MinWidth="300" MaxWidth="400">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding Title}" />
                                    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,6,0,0">
                                                    <TextBlock FontSize="11" Foreground="#FFA9ABBE" Text="{Binding Label}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="White"
                                                               Text="{Binding Value}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
