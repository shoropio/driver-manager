<UserControl x:Class="DriverManager.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Descargas" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Descarga manual de controladores. Indica un nombre y la URL directa del instalador." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="12" Foreground="#FFA9ABBE" Text="Nombre del controlador" />
                    <TextBox Margin="0,6,0,0" Text="{Binding DownloadName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Nombre visible para la descarga" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="12" Foreground="#FFA9ABBE" Text="URL de descarga" />
                    <TextBox Margin="0,6,0,0" Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="URL directa del instalador (.exe, .zip)" />
                </StackPanel>

                <Button Grid.Column="4" VerticalAlignment="Bottom" Style="{StaticResource ActionButtonStyle}"
                        Content="Descargar" Command="{Binding DownloadCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="Bold" Text="Carpeta de descargas" />
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#FFA9ABBE"
                           Text="Los archivos se guardan aquí. Puedes cambiar la ruta en Configuración." />
                <TextBlock Margin="0,12,0,0" FontSize="13" Foreground="#FF7AC5FF"
                           Text="{Binding DownloadsFolder}" TextWrapping="Wrap" />
                <TextBlock Margin="0,16,0,0" FontSize="13" Foreground="#FF9ED27A"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
