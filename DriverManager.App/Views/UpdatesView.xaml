<UserControl x:Class="DriverManager.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Actualizaciones" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Busca actualizaciones disponibles para tus controladores e instálalas." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox ItemsSource="{Binding UpdateSourceOptions}"
                      SelectedItem="{Binding SelectedUpdateSource}"
                      ToolTip="Fuente de actualizaciones (se aplica al buscar)" />
            <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Content="Buscar actualizaciones"
                    Command="{Binding CheckUpdatesCommand}" />
            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Content="Instalar todas"
                    Command="{Binding InstallUpdatesCommand}" />
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="4" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1"
                        Background="#FF26263C" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold"
                                   Text="Dispositivo" />
                        <TextBlock Grid.Column="1" Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold"
                                   Text="Categoría" />
                        <TextBlock Grid.Column="2" Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold"
                                   Text="Versión instalada" />
                        <TextBlock Grid.Column="3" Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold"
                                   Text="Versión disponible" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Grid.ColumnSpan="4"
                         ItemsSource="{Binding PendingUpdates}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF26263C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <Border BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock FontWeight="SemiBold" FontSize="12.5"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" />
                                </Border>

                                <Border Grid.Column="1" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Foreground="#FFA9ABBE" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Category}" ToolTip="{Binding Category}" />
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock FontFamily="Consolas" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding InstalledVersion}" ToolTip="{Binding InstalledVersion}" />
                                </Border>

                                <Border Grid.Column="3" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FF9ED27A"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{Binding AvailableVersion}" ToolTip="{Binding AvailableVersion}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FFA9ABBE" FontSize="14"
                           Text="No hay actualizaciones pendientes. Busca actualizaciones primero.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingUpdates.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
