<UserControl x:Class="DriverManager.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Actualizaciones" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Busca actualizaciones disponibles para tus controladores e instálalas." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ComboBox ItemsSource="{Binding UpdateSourceOptions}"
                      SelectedItem="{Binding SelectedUpdateSource}"
                      ToolTip="Fuente de actualizaciones (se aplica al buscar)" />
            <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Content="Buscar actualizaciones"
                    Command="{Binding CheckUpdatesCommand}" />
            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Content="Instalar todas"
                    Command="{Binding InstallUpdatesCommand}" />
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="180" />
                    <ColumnDefinition Width="2*" MinWidth="120" />
                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                    <ColumnDefinition Width="1*" MinWidth="80" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="5" Style="{StaticResource TableRowBorderStyle}" Background="#FF26263C">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Dispositivo" ToolTip="Nombre del dispositivo" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="Categoría" ToolTip="Categoría del controlador" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="Versión instalada" ToolTip="Versión actualmente instalada" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="Versión disponible" ToolTip="Versión más reciente disponible" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="Acción" ToolTip="Instalar esta actualización" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Grid.ColumnSpan="5"
                          ItemsSource="{Binding PendingUpdates}"
                          Background="Transparent" BorderThickness="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF26263C" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF32334B" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" MinWidth="180" />
                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                                    <ColumnDefinition Width="1*" MinWidth="80" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}" FontWeight="SemiBold"
                                               Text="{Binding DeviceName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" />
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}" Foreground="#FFA9ABBE"
                                               Text="{Binding Category}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableVersionTextStyle}"
                                               Text="{Binding InstalledVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledVersion}" />
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableVersionTextStyle}" Foreground="#FF9ED27A"
                                               Text="{Binding AvailableVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AvailableVersion}" />
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource TableRowBorderStyle}" Padding="8,6">
                                    <Button Content="Instalar"
                                            Command="{Binding DataContext.InstallDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryActionButtonStyle}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FFA9ABBE" FontSize="14"
                           Text="{Binding EmptyUpdateMessage}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PendingUpdates.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>