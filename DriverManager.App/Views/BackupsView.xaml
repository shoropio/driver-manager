<UserControl x:Class="DriverManager.App.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="LabelTextStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFA9ABBE" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Respaldos de controladores" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="Crea copias de seguridad de tus controladores y gestiona los respaldos existentes." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Carpeta de respaldos" />
                <TextBlock Margin="0,4,0,0" FontSize="13" Foreground="#FF7AC5FF"
                           Text="{Binding BackupFolder}" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource ActionButtonStyle}" Content="Crear respaldo"
                        Command="{Binding CreateBackupCommand}" />
                <Button Margin="12,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="Actualizar lista"
                        Command="{Binding RefreshBackupsCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="4" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1"
                        Background="#FF26263C" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold" Text="Respaldo" />
                        <TextBlock Grid.Column="1" Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold" Text="Ubicación" />
                        <TextBlock Grid.Column="2" Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold" Text="Creado" />
                        <TextBlock Grid.Column="3" Foreground="#FF8B8FA6" FontSize="12" FontWeight="Bold" Text="Tamaño" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Grid.ColumnSpan="4">
                    <ListBox ItemsSource="{Binding Backups}"
                             SelectedItem="{Binding SelectedBackup}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FF26263C" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF32334B" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock FontWeight="SemiBold" FontSize="12.5"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding BackupName}" ToolTip="{Binding BackupName}" />
                                    </Border>

                                    <Border Grid.Column="1" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock Foreground="#FFA9ABBE" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding BackupPath}" ToolTip="{Binding BackupPath}" />
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}" />
                                    </Border>

                                    <Border Grid.Column="3" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                        <TextBlock FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding SizeBytes, StringFormat={}{0:N0} bytes}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#FFA9ABBE" FontSize="14"
                               Text="No hay respaldos todavía. Crea uno para proteger tus controladores.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Backups.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Border Grid.Row="2" Grid.ColumnSpan="4" BorderBrush="#FF2D2D43" BorderThickness="0,1,0,0" Padding="12,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="Eliminar seleccionado"
                                Command="{Binding DeleteBackupCommand}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
