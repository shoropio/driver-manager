<UserControl x:Class="DriverManager.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8B8FA6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="RowTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="VersionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFC9D3E6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Controladores instalados" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="{Binding Drivers.Count, StringFormat={}{0} controladores detectados en este equipo.}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding DriverFilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar por nombre, fabricante o categoría" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding SelectedStatusFilter}" />
            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Content="Escanear"
                    Command="{Binding ScanDriversCommand}" />
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="6" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1"
                        Background="#FF26263C" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource ColumnHeaderTextStyle}" Text="Dispositivo" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Fabricante" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Categoría" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Versión instalada" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}" Text="Versión disponible" />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderTextStyle}" Text="Estado" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Grid.ColumnSpan="6"
                         ItemsSource="{Binding DriversView}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF26263C" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>

                                <Border BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Style="{StaticResource RowTextStyle}" FontWeight="SemiBold"
                                               Text="{Binding DeviceName}" ToolTip="{Binding DeviceName}" />
                                </Border>

                                <Border Grid.Column="1" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Style="{StaticResource RowTextStyle}"
                                               Text="{Binding Manufacturer}" ToolTip="{Binding Manufacturer}" />
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Style="{StaticResource RowTextStyle}" Foreground="#FFA9ABBE"
                                               Text="{Binding Category}" ToolTip="{Binding Category}" />
                                </Border>

                                <Border Grid.Column="3" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Style="{StaticResource VersionTextStyle}"
                                               Text="{Binding InstalledVersion}" ToolTip="{Binding InstalledVersion}" />
                                </Border>

                                <Border Grid.Column="4" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Style="{StaticResource VersionTextStyle}" Foreground="#FF9ED27A"
                                               Text="{Binding AvailableVersion}" ToolTip="{Binding AvailableVersion}" />
                                </Border>

                                <Border Grid.Column="5" BorderBrush="#FF2D2D43" BorderThickness="0,0,0,1" Padding="12,8">
                                    <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource RowTextStyle}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                        <Setter Property="Foreground" Value="#FFA9ABBE" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="UpToDate">
                                                        <Setter Property="Foreground" Value="#FF9ED27A" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                                        <Setter Property="Foreground" Value="#FFFFB454" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="ProblemDetected">
                                                        <Setter Property="Foreground" Value="#FFFF6B6B" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="BackupAvailable">
                                                        <Setter Property="Foreground" Value="#FF7AC5FF" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Unknown">
                                                        <Setter Property="Foreground" Value="#FF8B8FA6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FFA9ABBE" FontSize="14"
                           Text="No hay controladores para mostrar. Pulsa Escanear para detectarlos.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Drivers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
