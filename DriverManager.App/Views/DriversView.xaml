<UserControl x:Class="DriverManager.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="24" FontWeight="Bold" Text="Controladores instalados" />
            <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                       Text="{Binding Drivers.Count, StringFormat={}{0} controladores detectados en este equipo.}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding DriverFilterText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Buscar por nombre, fabricante o categoría" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding StatusFilterOptions}"
                      SelectedItem="{Binding SelectedStatusFilter}" />
            <Button Grid.Column="4" Style="{StaticResource ActionButtonStyle}" Content="Escanear"
                    Command="{Binding ScanDriversCommand}" />
        </Grid>

        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="180" />
                    <ColumnDefinition Width="2*" MinWidth="120" />
                    <ColumnDefinition Width="1.5*" MinWidth="100" />
                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                    <ColumnDefinition Width="1*" MinWidth="80" />
                    <ColumnDefinition Width="1.5*" MinWidth="100" />
                </Grid.ColumnDefinitions>

                <Border Grid.ColumnSpan="7" Style="{StaticResource TableRowBorderStyle}" Background="#FF26263C">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.5*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Style="{StaticResource TableHeaderTextStyle}" Text="Dispositivo" ToolTip="Nombre del dispositivo" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderTextStyle}" Text="Fabricante" ToolTip="Fabricante del dispositivo" />
                        <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderTextStyle}" Text="Categoría" ToolTip="Categoría del controlador" />
                        <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderTextStyle}" Text="Versión instalada" ToolTip="Versión actualmente instalada" />
                        <TextBlock Grid.Column="4" Style="{StaticResource TableHeaderTextStyle}" Text="Versión disponible" ToolTip="Versión más reciente disponible" />
                        <TextBlock Grid.Column="5" Style="{StaticResource TableHeaderTextStyle}" Text="Acción" ToolTip="Acción disponible" />
                        <TextBlock Grid.Column="6" Style="{StaticResource TableHeaderTextStyle}" Text="Estado" ToolTip="Estado del controlador" />
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" Grid.ColumnSpan="7"
                         ItemsSource="{Binding DriversView}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FF26263C" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF32334B" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" MinWidth="180" />
                                    <ColumnDefinition Width="2*" MinWidth="120" />
                                    <ColumnDefinition Width="1.5*" MinWidth="100" />
                                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                                    <ColumnDefinition Width="1.2*" MinWidth="90" />
                                    <ColumnDefinition Width="1*" MinWidth="80" />
                                    <ColumnDefinition Width="1.5*" MinWidth="100" />
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconDrivers}" Width="14" Height="14" Stretch="Uniform"
                                              StrokeThickness="1.2" Stroke="#FF8B8FA6" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource TableRowTextStyle}" FontWeight="SemiBold"
                                                   Margin="8,0,0,0" Text="{Binding DeviceName}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}"
                                               Text="{Binding Manufacturer}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Manufacturer}" />
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableRowTextStyle}" Foreground="#FFA9ABBE"
                                               Text="{Binding Category}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                </Border>

                                <Border Grid.Column="3" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableVersionTextStyle}"
                                               Text="{Binding InstalledVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstalledVersion}" />
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <TextBlock Style="{StaticResource TableVersionTextStyle}" Foreground="#FF9ED27A"
                                               Text="{Binding AvailableVersion}" TextTrimming="CharacterEllipsis" ToolTip="{Binding AvailableVersion}" />
                                </Border>

                                <Border Grid.Column="5" Style="{StaticResource TableRowBorderStyle}" Padding="8,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Instalar"
                                                Command="{Binding DataContext.InstallDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryActionButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DriverInfo.HasUpdate}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <TextBlock Text="—" ToolTip="Sin actualización disponible">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableRowTextStyle}">
                                                    <Setter Property="Foreground" Value="#FF5A6072" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DriverInfo.HasUpdate}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="6" Style="{StaticResource TableRowBorderStyle}" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Style="{StaticResource StatusDotStyle}" />
                                        <TextBlock Text="{Binding StatusText}" ToolTip="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableRowTextStyle}">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Installed">
                                                            <Setter Property="Foreground" Value="#FFA9ABBE" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="UpToDate">
                                                            <Setter Property="Foreground" Value="#FF9ED27A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                                                            <Setter Property="Foreground" Value="#FFFFB454" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ProblemDetected">
                                                            <Setter Property="Foreground" Value="#FFFF6B6B" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="BackupAvailable">
                                                            <Setter Property="Foreground" Value="#FF7AC5FF" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Unknown">
                                                            <Setter Property="Foreground" Value="#FF8B8FA6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="7" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#FFA9ABBE" FontSize="14"
                           Text="No hay controladores para mostrar. Pulsa Escanear para detectarlos.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Drivers.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>