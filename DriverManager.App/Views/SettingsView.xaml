<UserControl x:Class="DriverManager.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:DriverManager.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="LabelTextStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#FFA9ABBE" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Text="Configuración" />
                <TextBlock Margin="0,6,0,0" FontSize="13" Foreground="#FFA9ABBE"
                           Text="Configura las fuentes de actualización, las carpetas de respaldo y descargas." />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,20,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Text="Actualizaciones" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource LabelTextStyle}"
                               Text="La fuente de actualizaciones se usa al buscar nuevas versiones." />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource LabelTextStyle}" Text="Fuente de actualizaciones" />
                    <ComboBox Margin="0,6,0,0" Width="280" HorizontalAlignment="Left"
                              ItemsSource="{Binding UpdateSourceOptions}"
                              SelectedItem="{Binding SelectedUpdateSource}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource LabelTextStyle}" Text="Service Tag de Dell" />
                    <TextBox Margin="0,6,0,0" Width="280" HorizontalAlignment="Left"
                             Text="{Binding Settings.DellServiceTag, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Etiqueta de servicio del equipo Dell (necesaria solo si usas Dell como fuente)" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource LabelTextStyle}" Text="App ID de Dell (TechDirect)" />
                    <TextBox Margin="0,6,0,0" Width="280" HorizontalAlignment="Left"
                             Text="{Binding Settings.DellAppId, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Identificador de aplicación registrada en Dell (necesario solo si usas Dell como fuente)" />

                    <CheckBox Margin="0,16,0,0" Foreground="White"
                              IsChecked="{Binding Settings.CheckUpdatesOnStartup}"
                              Content="Buscar actualizaciones al iniciar la aplicación" />

                    <TextBlock Margin="0,12,0,0" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap"
                               Text="Nota: NVIDIA (GeForce) y Dell descargan los controladores pero no los instalan automáticamente. Windows Update sí los instala." />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="Bold" Text="Carpetas" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource LabelTextStyle}" Text="Carpeta de respaldos" />
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="0,16,0,0" Style="{StaticResource LabelTextStyle}" Text="Carpeta de descargas" />
                    <TextBox Margin="0,6,0,0"
                             Text="{Binding DownloadsFolder, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="3" Margin="0,20,0,0" Orientation="Horizontal">
                <Button Style="{StaticResource ActionButtonStyle}" Content="Guardar configuración"
                        Command="{Binding SaveSettingsCommand}" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="#FF9ED27A"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
